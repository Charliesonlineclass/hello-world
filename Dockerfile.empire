# ═══════════════════════════════════════════════════════════════════════
# SCORPION EMPIRE - FastAPI Backend Container
# ═══════════════════════════════════════════════════════════════════════

FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY empire/requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY empire/ ./empire/
COPY data/ ./data/

# Set environment variables
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV OLLAMA_HOST=ollama:11434
ENV CHROMADB_HOST=chromadb:8000

# Create non-root user for security
RUN useradd -m -u 1000 scorpion && \
    chown -R scorpion:scorpion /app
USER scorpion

# Expose port
EXPOSE 8800

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8800/health-check || exit 1

# Start command
CMD ["python", "-m", "uvicorn", "empire.api.main:app", "--host", "0.0.0.0", "--port", "8800"]
