# =============================================================================
# SCORPION Configuration - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
# Environment mode: development, staging, production
ENVIRONMENT=development

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# Host to bind the API server
API_HOST=0.0.0.0

# Port for SCORPION API (MOUTH)
API_PORT=8080

# Secret key for JWT tokens - CHANGE THIS IN PRODUCTION!
API_SECRET_KEY=change-me-to-a-secure-random-string-in-production

# Token expiry in hours
TOKEN_EXPIRY_HOURS=24

# Enable debug mode (never in production)
API_DEBUG=false

# -----------------------------------------------------------------------------
# PostgreSQL Database
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=scorpion
POSTGRES_USER=scorpion
POSTGRES_PASSWORD=your-secure-database-password

# -----------------------------------------------------------------------------
# Redis Cache
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# -----------------------------------------------------------------------------
# Ollama AI Service
# -----------------------------------------------------------------------------
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_DEFAULT_MODEL=mistral
OLLAMA_TIMEOUT=120

# -----------------------------------------------------------------------------
# AI Babies - Model Configuration
# -----------------------------------------------------------------------------
# MARCUS: General intelligence and customer interaction
MARCUS_MODEL=mistral

# HERMES: Fast responses and quick tasks
HERMES_MODEL=phi

# ATHENA: Code generation and technical analysis
ATHENA_MODEL=codellama

# APOLLO: Creative writing and content generation
APOLLO_MODEL=llama2

# -----------------------------------------------------------------------------
# ChromaDB Vector Database
# -----------------------------------------------------------------------------
CHROMADB_HOST=localhost
CHROMADB_PORT=8000
CHROMADB_TOKEN=
CHROMADB_PERSIST_DIR=./data/chromadb

# -----------------------------------------------------------------------------
# n8n Workflow Automation
# -----------------------------------------------------------------------------
N8N_HOST=localhost
N8N_PORT=5678
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=your-n8n-password

# -----------------------------------------------------------------------------
# Phone Bridge (Termux Integration)
# -----------------------------------------------------------------------------
PHONE_BRIDGE_HOST=0.0.0.0
PHONE_BRIDGE_PORT=8888
PHONE_BRIDGE_SECRET=your-phone-bridge-secret

# -----------------------------------------------------------------------------
# Directory Paths
# -----------------------------------------------------------------------------
DATA_DIR=./data
LOGS_DIR=./logs
BACKUP_DIR=./backups

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ENABLE_N8N=true
ENABLE_SCHEDULER=true
ENABLE_HEALTH_MONITOR=true

# -----------------------------------------------------------------------------
# Email Notifications (SMTP)
# -----------------------------------------------------------------------------
NOTIFICATION_EMAIL=your-email@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@gmail.com
SMTP_PASSWORD=your-smtp-app-password

# -----------------------------------------------------------------------------
# SMS Notifications (Twilio)
# -----------------------------------------------------------------------------
NOTIFICATION_PHONE=+1234567890
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1987654321

# -----------------------------------------------------------------------------
# Client-Specific Settings (Examples)
# -----------------------------------------------------------------------------
# J3 Construction
J3_COMPANY_NAME=J3 Construction LLC
J3_CONTACT_EMAIL=quotes@j3construction.com
J3_CONTACT_PHONE=555-0100

# NSIPA Healthcare
NSIPA_PRACTICE_NAME=NSIPA Medical Practice
NSIPA_CONTACT_EMAIL=appointments@nsipa.com
NSIPA_CONTACT_PHONE=555-0200

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Webhook secret for verifying incoming webhooks
WEBHOOK_SECRET=your-webhook-secret

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# -----------------------------------------------------------------------------
# Backup Configuration
# -----------------------------------------------------------------------------
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_KEY=your-backup-encryption-key

# -----------------------------------------------------------------------------
# Docker Network (for containerized deployment)
# -----------------------------------------------------------------------------
DOCKER_NETWORK=scorpion-net
COMPOSE_PROJECT_NAME=scorpion
